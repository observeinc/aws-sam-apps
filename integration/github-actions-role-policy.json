{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormationStackScoped",
      "Effect": "Allow",
      "Action": [
        "cloudformation:UpdateStack",
        "cloudformation:DeleteStack",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:ListStackResources",
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:ListChangeSets",
        "cloudformation:TagResource",
        "cloudformation:UntagResource"
      ],
      "Resource": "arn:aws:cloudformation:*:723346149663:stack/*/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/managed-by": "integration-test"
        }
      }
    },
    {
      "Sid": "CloudFormationCreateStackWithTag",
      "Effect": "Allow",
      "Action": "cloudformation:CreateStack",
      "Resource": "arn:aws:cloudformation:*:723346149663:stack/*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/managed-by": "integration-test"
        }
      }
    },
    {
      "Sid": "CloudFormationTransforms",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": [
        "arn:aws:cloudformation:*:aws:transform/Serverless-2016-10-31",
        "arn:aws:cloudformation:*:aws:transform/Include",
        "arn:aws:cloudformation:*:aws:transform/LanguageExtensions"
      ]
    },
    {
      "Sid": "CloudFormationUnscoped",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ListStacks",
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamInstallRoleLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::723346149663:role/integration-test-*"
    },
    {
      "Sid": "IamPassRoleToCloudFormation",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::723346149663:role/integration-test-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "OrganizationsRead",
      "Effect": "Allow",
      "Action": [
        "organizations:DescribeOrganization",
        "organizations:ListAccounts",
        "organizations:ListRoots",
        "organizations:ListAWSServiceAccessForOrganization"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S3InAccountRWConfigure",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetBucketAcl",
        "s3:PutBucketAcl",
        "s3:GetBucketCors",
        "s3:PutBucketCors",
        "s3:GetBucketWebsite",
        "s3:GetBucketLogging",
        "s3:PutBucketLogging",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketReplication",
        "s3:GetReplicationConfiguration",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls",
        "s3:PutBucketOwnershipControls",
        "s3:DeleteBucketOwnershipControls",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:GetAccelerateConfiguration",
        "s3:PutAccelerateConfiguration",
        "s3:GetBucketNotification",
        "s3:PutBucketNotification",
        "s3:PutBucketObjectLockConfiguration",
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:GetObjectTagging",
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "723346149663"
        }
      }
    },
    {
      "Sid": "S3ObserveIncReleaseBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAcl",
        "s3:GetObjectAttributes",
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::observeinc-*",
        "arn:aws:s3:::observeinc-*/*"
      ]
    },
    {
      "Sid": "S3DeleteBucket",
      "Effect": "Allow",
      "Action": "s3:DeleteBucket",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "s3:ResourceAccount": "723346149663"
        }
      }
    },
    {
      "Sid": "S3ListAllMyBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "S3AccessPoints",
      "Effect": "Allow",
      "Action": [
        "s3:CreateAccessPoint",
        "s3:DeleteAccessPoint",
        "s3:GetAccessPoint",
        "s3:ListAccessPoints",
        "s3:GetAccessPointPolicy",
        "s3:PutAccessPointPolicy",
        "s3:DeleteAccessPointPolicy",
        "s3:GetAccessPointPolicyStatus",
        "s3:GetAccessPointPublicAccessBlock",
        "s3:PutAccessPointPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:*:723346149663:accesspoint/*"
    },
    {
      "Sid": "KmsCreateKeyWithTag",
      "Effect": "Allow",
      "Action": "kms:CreateKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/managed-by": "integration-test"
        }
      }
    },
    {
      "Sid": "KmsAdminOnTaggedKey",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:ScheduleKeyDeletion",
        "kms:CancelKeyDeletion",
        "kms:EnableKey",
        "kms:DisableKey",
        "kms:EnableKeyRotation",
        "kms:DisableKeyRotation",
        "kms:GetKeyRotationStatus",
        "kms:GetKeyPolicy",
        "kms:PutKeyPolicy",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:ListResourceTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/managed-by": "integration-test"
        }
      }
    },
    {
      "Sid": "KmsAlias",
      "Effect": "Allow",
      "Action": [
        "kms:ListAliases",
        "kms:CreateAlias",
        "kms:DeleteAlias",
        "kms:UpdateAlias"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KmsDataPlaneViaS3",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "kms:ViaService": "s3.*.amazonaws.com"
        }
      }
    },
    {
      "Sid": "SnsScaffolding",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:Subscribe",
        "sns:ListTagsForResource",
        "sns:TagResource",
        "sns:UntagResource"
      ],
      "Resource": "arn:aws:sns:*:723346149663:integration-test-*"
    },
    {
      "Sid": "SnsSubscription",
      "Effect": "Allow",
      "Action": [
        "sns:Unsubscribe",
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes",
        "sns:ListSubscriptions",
        "sns:ListSubscriptionsByTopic"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SqsCreateQueueWithTag",
      "Effect": "Allow",
      "Action": "sqs:CreateQueue",
      "Resource": "arn:aws:sqs:*:723346149663:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/managed-by": "integration-test"
        }
      }
    },
    {
      "Sid": "SqsReadInAccount",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes",
        "sqs:ListQueueTags"
      ],
      "Resource": "arn:aws:sqs:*:723346149663:*"
    },
    {
      "Sid": "SqsMutateOnTaggedQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:DeleteQueue",
        "sqs:SetQueueAttributes",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": "arn:aws:sqs:*:723346149663:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/managed-by": "integration-test"
        }
      }
    },
    {
      "Sid": "ScriptCheckSubscriberInvokeLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:*:723346149663:function:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/managed-by": "integration-test"
        }
      }
    },
    {
      "Sid": "ScriptCheckSubscriberReadLogs",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:*:723346149663:log-group:/aws/lambda/*:*"
    },
    {
      "Sid": "CfnLogGroupsInline",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource",
        "logs:AssociateKmsKey",
        "logs:DisassociateKmsKey"
      ],
      "Resource": [
        "arn:aws:logs:*:723346149663:log-group:/aws/lambda/integration-test-*",
        "arn:aws:logs:*:723346149663:log-group:/aws/lambda/integration-test-*:*",
        "arn:aws:logs:*:723346149663:log-group:/aws/firehose/integration-test-*",
        "arn:aws:logs:*:723346149663:log-group:/aws/firehose/integration-test-*:*",
        "arn:aws:logs:*:723346149663:log-group:/aws/kinesisfirehose/integration-test-*",
        "arn:aws:logs:*:723346149663:log-group:/aws/kinesisfirehose/integration-test-*:*",
        "arn:aws:logs:*:723346149663:log-group:integration-test-*",
        "arn:aws:logs:*:723346149663:log-group:integration-test-*:*"
      ]
    },
    {
      "Sid": "CfnLogsDescribe",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CfnEventBridgeRules",
      "Effect": "Allow",
      "Action": "events:*",
      "Resource": "arn:aws:events:*:723346149663:rule/integration-test-*"
    },
    {
      "Sid": "CfnFirehoseDeliveryStreams",
      "Effect": "Allow",
      "Action": "firehose:*",
      "Resource": "arn:aws:firehose:*:723346149663:deliverystream/integration-test-*"
    },
    {
      "Sid": "CfnCloudwatchMetricStreams",
      "Effect": "Allow",
      "Action": "cloudwatch:*",
      "Resource": "arn:aws:cloudwatch:*:723346149663:metric-stream/integration-test-*"
    },
    {
      "Sid": "CfnSchedulerSchedules",
      "Effect": "Allow",
      "Action": "scheduler:*",
      "Resource": "arn:aws:scheduler:*:723346149663:schedule/*/integration-test-*"
    },
    {
      "Sid": "ScriptResetConfigService",
      "Effect": "Allow",
      "Action": [
        "config:DescribeConfigurationRecorders",
        "config:DescribeDeliveryChannels",
        "config:StopConfigurationRecorder",
        "config:DeleteDeliveryChannel",
        "config:DeleteConfigurationRecorder"
      ],
      "Resource": "*"
    }
  ]
}
